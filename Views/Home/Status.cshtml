@model int
@{
    ViewData["Title"] = $"Ошибка {Model}";
}

<div class="text-center py-5">
    <div class="display-1 fw-bold text-primary">@Model</div>
    @if (Model == 404)
    {
        <h2 class="mb-3">Страница или товар не найдены</h2>
        <p class="text-muted">Проверьте адрес или вернитесь к списку товаров.</p>
    }
    else
    {
        <h2 class="mb-3">Произошла ошибка</h2>
        <p class="text-muted">Код ответа сервера: @Model.</p>
    }
    <a asp-controller="Product" asp-action="Index" class="btn btn-primary">К списку товаров</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">На главную</a>
</div>
