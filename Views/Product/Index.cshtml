@model List<Product>
@{
    ViewData["Title"] = "Каталог товаров";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="fw-bold mb-1">Каталог товаров</h1>
        <p class="text-muted mb-0">
            Система управления товарами · Количество товаров:
            <span class="badge bg-primary rounded-pill">@Model.Count</span>
        </p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Добавить товар
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info shadow-sm">Каталог пуст. Добавьте первый товар.</div>
}

<div class="row g-4">
    @foreach (var product in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card product-card h-100 shadow-sm rounded-4">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary">ID: @product.Id</span>
                        @if (product.IsAvailable)
                        {
                            <span class="badge bg-success">В наличии</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Нет в наличии</span>
                        }
                    </div>

                    <h5 class="card-title">@product.Name</h5>
                    <p class="text-muted mb-2"><i class="bi bi-tag me-1"></i>@product.Category</p>
                    <p class="fs-4 fw-bold mt-auto">@product.Price.ToString("0.##") руб.</p>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">
                            Подробнее
                        </a>
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-pencil"></i> Изменить
                        </a>
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post"
                              onsubmit="return confirm('Удалить этот товар?');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i> Удалить
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
